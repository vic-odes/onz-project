# ─── Modèle LLM ──────────────────────────────────────────────────────────
# Provider est informatif (le nom du modèle suffit côté code).
LLM_PROVIDER=claude
# Exemples :
#   claude-sonnet-4-20250514   (Anthropic, supporte les blocks `document` natifs)
#   gpt-5-mini                 (OpenAI, modèle à raisonnement)
#   gpt-4o-mini                (OpenAI, classique)
#   gemini/gemini-2.5-flash    (Google)
#   mistral/mistral-large-latest
LLM_MODEL=claude-sonnet-4-20250514
# Plafond de jetons de sortie par requête (le document complet dépasse 8000)
LLM_MAX_TOKENS=16000

# Plafond de tokens de sortie. Défaut interne : 16000 (suffisant pour les modèles
# à raisonnement type GPT-5/o1, qui consomment des tokens invisibles).
# À baisser si ton plan/modèle est plus restrictif (ex. Mistral Small : 4096).
# LLM_MAX_TOKENS=16000

# ─── Clés API (renseigner UNE seule selon le provider) ───────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Azure OpenAI (passé explicitement à litellm.acompletion)
# AZURE_API_KEY=
# AZURE_API_BASE=
# AZURE_API_VERSION=

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Base de données ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./onz_projects.db

# ─── Authentification JWT — OBLIGATOIRE ──────────────────────────────────
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# ─── Cookie de session (le JWT est posé dans un cookie httpOnly) ──────────
# secure=true : cookie envoyé en HTTPS uniquement (localhost reste toléré).
# samesite=lax : protège du CSRF. Mettre "none" (+ secure=true) uniquement si le
# front et l'API sont sur des domaines réellement distincts.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# ─── Limitation de débit (anti brute-force) ──────────────────────────────
AUTH_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
# RATELIMIT_STORAGE_URI=redis://localhost:6379   # pour un déploiement multi-workers
